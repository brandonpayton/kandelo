{
  "arch": "wasm32",
  "binary-format": "wasm",
  "crt-objects-fallback": "true",
  "data-layout": "e-m:e-p:32:32-p10:8:8-p20:8:8-i64:64-i128:128-n32:64-S128-ni:1:10:20",
  "dll-prefix": "",
  "dll-suffix": ".wasm",
  "dynamic-linking": true,
  "eh-frame-header": false,
  "emit-debug-gdb-scripts": false,
  "env": "musl",
  "exe-suffix": ".wasm",
  "features": "+atomics,+bulk-memory,+mutable-globals",
  "generate-arange-section": false,
  "has-thread-local": true,
  "is-like-wasm": true,
  "linker": "rust-lld",
  "linker-flavor": "wasm-lld",
  "linker-is-gnu": false,
  "lld-flavor": "wasm",
  "llvm-target": "wasm32-unknown-unknown",
  "max-atomic-width": 64,
  "metadata": {
    "description": "WebAssembly on the Kandelo POSIX kernel (full std)",
    "host_tools": false,
    "std": true,
    "tier": 3
  },
  "only-cdylib": true,
  "os": "kandelo",
  "panic-strategy": "abort",
  "relocation-model": "static",
  "target-family": [
    "unix",
    "wasm"
  ],
  "target-pointer-width": 32,
  "tls-model": "local-exec",
  "vendor": "unknown"
}