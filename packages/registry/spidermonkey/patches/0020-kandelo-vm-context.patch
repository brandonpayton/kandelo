+// __kandeloVmCompile(code, { filename, lineOffset }) -> opaque script handle.
+// Compiles to a realm-independent Stencil so one handle can run in many
+// contexts (Node's vm.Script reused across contexts).
+static bool KandeloVmCompile(JSContext* cx, unsigned argc, Value* vp) {
+  CallArgs args = CallArgsFromVp(argc, vp);
+  if (args.length() < 1 || !args[0].isString()) {
+    JS_ReportErrorASCII(cx, "__kandeloVmCompile(code, opts)");
+    return false;
+  }
+  RootedString code(cx, args[0].toString());
+
+  RootedString filenameStr(cx);
+  int32_t lineOffset = 0;
+  if (args.length() >= 2 && args[1].isObject()) {
+    RootedObject o(cx, &args[1].toObject());
+    RootedValue v(cx);
+    if (!JS_GetProperty(cx, o, "filename", &v)) {
+      return false;
+    }
+    if (v.isString()) {
+      filenameStr = v.toString();
+    }
+    if (!JS_GetProperty(cx, o, "lineOffset", &v)) {
+      return false;
+    }
+    if (v.isInt32()) {
+      lineOffset = v.toInt32();
+    }
+  }
+  UniqueChars filenameBytes;
+  const char* filename = "evalmachine.<anonymous>";
+  if (filenameStr) {
+    filenameBytes = JS_EncodeStringToUTF8(cx, filenameStr);
+    if (!filenameBytes) {
+      return false;
+    }
+    filename = filenameBytes.get();
+  }
+
+  JS::CompileOptions compileOptions(cx);
+  compileOptions.setFileAndLine(filename, 1 + lineOffset);
+
+  AutoStableStringChars stable(cx);
+  if (!stable.initTwoByte(cx, code)) {
+    return false;
+  }
+  JS::SourceText<char16_t> srcBuf;
+  if (!srcBuf.initMaybeBorrowed(cx, stable)) {
+    return false;
+  }
+
+  RefPtr<JS::Stencil> stencil =
+      JS::CompileGlobalScriptToStencil(cx, compileOptions, srcBuf);
+  if (!stencil) {
+    return false;
+  }
+  RootedObject handle(cx, js::StencilObject::create(cx, std::move(stencil)));
+  if (!handle) {
+    return false;
+  }
+  args.rval().setObject(*handle);
+  return true;
+}
+
+// __kandeloVmRunInContext(codeOrScriptHandle, ctx,
+//                         { filename, lineOffset }) -> result.
+// Enters ctx's realm, compiles (string) or instantiates (handle), executes,
+// and marshals the result — or a thrown value — back to the caller realm.
+static bool KandeloVmRunInContext(JSContext* cx, unsigned argc, Value* vp) {
+  CallArgs args = CallArgsFromVp(argc, vp);
+  if (args.length() < 2) {
+    JS_ReportErrorASCII(cx, "__kandeloVmRunInContext(code, ctx, opts)");
+    return false;
+  }
+  if (!args[1].isObject()) {
+    JS_ReportErrorASCII(cx, "vm context must be an object");
+    return false;
+  }
+  RootedObject target(cx, UncheckedUnwrap(&args[1].toObject(), true));
+  target = ToWindowIfWindowProxy(target);
+  if (!target || !JS_IsGlobalObject(target)) {
+    JS_ReportErrorASCII(cx, "invalid vm context");
+    return false;
+  }
+
+  RootedString codeStr(cx);
+  Rooted<js::StencilObject*> stencilObj(cx);
+  if (args[0].isString()) {
+    codeStr = args[0].toString();
+  } else if (args[0].isObject()) {
+    stencilObj = args[0].toObject().maybeUnwrapIf<js::StencilObject>();
+    if (!stencilObj) {
+      JS_ReportErrorASCII(cx, "invalid compiled script handle");
+      return false;
+    }
+  } else {
+    JS_ReportErrorASCII(cx, "vm code must be a string or compiled script");
+    return false;
+  }
+
+  RootedString filenameStr(cx);
+  int32_t lineOffset = 0;
+  if (args.length() >= 3 && args[2].isObject()) {
+    RootedObject o(cx, &args[2].toObject());
+    RootedValue v(cx);
+    if (!JS_GetProperty(cx, o, "filename", &v)) {
+      return false;
+    }
+    if (v.isString()) {
+      filenameStr = v.toString();
+    }
+    if (!JS_GetProperty(cx, o, "lineOffset", &v)) {
+      return false;
+    }
+    if (v.isInt32()) {
+      lineOffset = v.toInt32();
+    }
+  }
+  UniqueChars filenameBytes;
+  const char* filename = "evalmachine.<anonymous>";
+  if (filenameStr) {
+    filenameBytes = JS_EncodeStringToUTF8(cx, filenameStr);
+    if (!filenameBytes) {
+      return false;
+    }
+    filename = filenameBytes.get();
+  }
+
+  // Flatten source chars in the caller realm; the borrowed range is consumed
+  // inside the target realm below (mirrors EvalInContext).
+  AutoStableStringChars stable(cx);
+  if (codeStr) {
+    if (!stable.initTwoByte(cx, codeStr)) {
+      return false;
+    }
+  }
+
+  RootedValue rval(cx);
+  bool ok = false;
+  {
+    JSAutoRealm ar(cx, target);
+
+    JS::CompileOptions compileOptions(cx);
+    compileOptions.setFileAndLine(filename, 1 + lineOffset);
+
+    RootedScript script(cx);
+    if (codeStr) {
+      JS::SourceText<char16_t> srcBuf;
+      if (!srcBuf.init(cx, stable.twoByteRange().begin().get(),
+                       stable.twoByteRange().length(),
+                       JS::SourceOwnership::Borrowed)) {
+        return false;
+      }
+      script = JS::Compile(cx, compileOptions, srcBuf);
+    } else {
+      JS::InstantiateOptions instantiateOptions(compileOptions);
+      script = JS::InstantiateGlobalStencil(cx, instantiateOptions,
+                                            stencilObj->stencil());
+    }
+
+    if (script) {
+      ok = JS_ExecuteScript(cx, script, &rval);
+    }
+  }
+
+  if (ok) {
+    if (!cx->compartment()->wrap(cx, &rval)) {
+      return false;
+    }
+    args.rval().set(rval);
+    return true;
+  }
+
+  // Marshal a thrown value back to the caller realm rather than leaving it in
+  // the target realm.
+  if (JS_IsExceptionPending(cx)) {
+    RootedValue exc(cx);
+    if (JS_GetPendingException(cx, &exc)) {
+      JS_ClearPendingException(cx);
+      if (!cx->compartment()->wrap(cx, &exc)) {
+        return false;
+      }
+      JS_SetPendingException(cx, exc);
+    }
+  }
+  return false;
+}
