+// Kandelo: route bare import specifiers (not "./", "../", "/", or
+// "javascript:") through the node-compat resolver installed by bootstrap.js.
+// __kandeloResolveBare(specifier, referrerPath) returns a synthetic module
+// *path* (a token) for a Node builtin or node_modules package, and registers
+// the generated ES-module source under that token in __kandeloBareSources for
+// fetchSource() to serve. It returns null when the specifier cannot be resolved
+// there, in which case the loader falls back to its default file-path behavior
+// (which surfaces the honest "can't open" error).
+static bool KandeloResolveBareSpecifier(JSContext* cx,
+                                        Handle<JSLinearString*> specifier,
+                                        Handle<JSLinearString*> referrerPath,
+                                        JS::MutableHandleString out) {
+  out.set(nullptr);
+
+  RootedObject global(cx, JS::CurrentGlobalOrNull(cx));
+  if (!global) {
+    return true;
+  }
+
+  RootedValue fnVal(cx);
+  if (!JS_GetProperty(cx, global, "__kandeloResolveBare", &fnVal)) {
+    return false;
+  }
+  if (!fnVal.isObject() || !JS::IsCallable(&fnVal.toObject())) {
+    return true;
+  }
+
+  JS::RootedValueArray<2> args(cx);
+  args[0].setString(specifier);
+  if (referrerPath) {
+    args[1].setString(referrerPath);
+  } else {
+    args[1].setNull();
+  }
+
+  RootedValue rval(cx);
+  RootedValue callee(cx, fnVal);
+  if (!JS_CallFunctionValue(cx, global, callee, args, &rval)) {
+    return false;
+  }
+
+  if (rval.isString()) {
+    out.set(rval.toString());
+  }
+  return true;
+}
+
+// Kandelo: fetch synthetic bare-specifier module source registered in
+// globalThis.__kandeloBareSources[path], if any.
+static JSString* KandeloBareSource(JSContext* cx,
+                                   Handle<JSLinearString*> path) {
+  RootedObject global(cx, JS::CurrentGlobalOrNull(cx));
+  if (!global) {
+    return nullptr;
+  }
+
+  RootedValue sourcesVal(cx);
+  if (!JS_GetProperty(cx, global, "__kandeloBareSources", &sourcesVal)) {
+    return nullptr;
+  }
+  if (!sourcesVal.isObject()) {
+    return nullptr;
+  }
+
+  RootedObject sources(cx, &sourcesVal.toObject());
+  RootedValue keyVal(cx, StringValue(path));
+  RootedId keyId(cx);
+  if (!JS_ValueToId(cx, keyVal, &keyId)) {
+    return nullptr;
+  }
+
+  RootedValue srcVal(cx);
+  if (!JS_GetPropertyById(cx, sources, keyId, &srcVal)) {
+    return nullptr;
+  }
+  if (srcVal.isString()) {
+    return srcVal.toString();
+  }
+  return nullptr;
+}
