+// Kandelo: node-compat require() of an ES module. Loads the module at |path|
+// through the shell ModuleLoader (shared registry -> dedups with import and
+// dynamic import()) and returns its namespace, or throws
+// ERR_REQUIRE_ASYNC_MODULE on a pending top-level await / rethrows a rejection.
+static bool KandeloNativeRequireModule(JSContext* cx, unsigned argc,
+                                       Value* vp) {
+  CallArgs args = CallArgsFromVp(argc, vp);
+  if (args.length() < 1 || !args[0].isString()) {
+    JS_ReportErrorASCII(cx, "__kandeloRequireModule(path)");
+    return false;
+  }
+  RootedString path(cx, args[0].toString());
+  ShellContext* sc = GetShellContext(cx);
+  if (!sc || !sc->moduleLoader) {
+    JS_ReportErrorASCII(cx, "module loader is not initialized");
+    return false;
+  }
+  return sc->moduleLoader->requireModuleNamespace(cx, path, args.rval());
+}
