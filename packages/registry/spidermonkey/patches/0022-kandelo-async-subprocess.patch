+// __kandeloPipe() -> [readFd, writeFd], both ends O_NONBLOCK.
+static bool KandeloNativePipe(JSContext* cx, unsigned argc, Value* vp) {
+  CallArgs args = CallArgsFromVp(argc, vp);
+  int fds[2];
+  if (pipe(fds) != 0) {
+    int err = errno;
+    JS_ReportErrorUTF8(cx, "pipe: %s", strerror(err));
+    KandeloDecoratePendingError(cx, err);
+    return false;
+  }
+  KandeloSetNonblocking(fds[0]);
+  KandeloSetNonblocking(fds[1]);
+  RootedObject arr(cx, JS::NewArrayObject(cx, 2));
+  if (!arr) {
+    close(fds[0]);
+    close(fds[1]);
+    return false;
+  }
+  RootedValue readVal(cx, Int32Value(fds[0]));
+  RootedValue writeVal(cx, Int32Value(fds[1]));
+  if (!JS_SetElement(cx, arr, 0, readVal) ||
+      !JS_SetElement(cx, arr, 1, writeVal)) {
+    return false;
+  }
+  args.rval().setObject(*arr);
+  return true;
+}
+
+// __kandeloFdRead/Write/Close: the socket read/write/close internals already
+// operate on an arbitrary fd via read()/write()/close() + the watch list, so
+// pipe fds reuse them directly. Read resolves an empty ArrayBuffer on EOF
+// (read()==0) rather than treating it as an error.
+static bool KandeloNativeFdRead(JSContext* cx, unsigned argc, Value* vp) {
+  return KandeloNativeSocketRead(cx, argc, vp);
+}
+
+static bool KandeloNativeFdWrite(JSContext* cx, unsigned argc, Value* vp) {
+  return KandeloNativeSocketWrite(cx, argc, vp);
+}
+
+static bool KandeloNativeFdClose(JSContext* cx, unsigned argc, Value* vp) {
+  return KandeloNativeSocketClose(cx, argc, vp);
+}
