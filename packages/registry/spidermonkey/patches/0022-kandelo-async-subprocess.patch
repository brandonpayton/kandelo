+// Resolve a __kandeloWaitPid promise with a Node-shaped
+// {code:number|null, signal:string|null} status object.
+static bool KandeloResolveChild(JSContext* cx, HandleObject promise,
+                                bool haveCode, int code,
+                                const char* signalName) {
+  RootedObject result(cx, JS_NewPlainObject(cx));
+  if (!result) return false;
+  RootedValue codeVal(cx, JS::NullValue());
+  if (haveCode) {
+    codeVal.setInt32(code);
+  }
+  RootedValue signalVal(cx, JS::NullValue());
+  if (signalName) {
+    RootedString s(cx, JS_NewStringCopyZ(cx, signalName));
+    if (!s) return false;
+    signalVal.setString(s);
+  }
+  if (!JS_DefineProperty(cx, result, "code", codeVal, JSPROP_ENUMERATE)) {
+    return false;
+  }
+  if (!JS_DefineProperty(cx, result, "signal", signalVal, JSPROP_ENUMERATE)) {
+    return false;
+  }
+  RootedValue resolved(cx, ObjectValue(*result));
+  return JS::ResolvePromise(cx, promise, resolved);
+}
+
+// Resolve a __kandeloWaitPid promise from a raw waitpid() status word.
+static bool KandeloResolveChildFromStatus(JSContext* cx, HandleObject promise,
+                                          int status) {
+  if (WIFEXITED(status)) {
+    return KandeloResolveChild(cx, promise, true, WEXITSTATUS(status), nullptr);
+  }
+  if (WIFSIGNALED(status)) {
+    return KandeloResolveChild(cx, promise, false, 0,
+                               KandeloSignalName(WTERMSIG(status)));
+  }
+  // Stopped/continued or otherwise not terminated: report no code yet.
+  return KandeloResolveChild(cx, promise, true, 0, nullptr);
 }
 
