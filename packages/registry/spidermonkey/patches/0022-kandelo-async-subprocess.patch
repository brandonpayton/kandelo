+// __kandeloKill(pid, sig) -> 0 on success; throws with .errno/.code on failure.
+static bool KandeloNativeKill(JSContext* cx, unsigned argc, Value* vp) {
+  CallArgs args = CallArgsFromVp(argc, vp);
+  int32_t pid, sig;
+  if (args.length() < 2 || !JS::ToInt32(cx, args[0], &pid) ||
+      !JS::ToInt32(cx, args[1], &sig)) {
+    return false;
+  }
+  if (kill(pid_t(pid), sig) != 0) {
+    int err = errno;
+    JS_ReportErrorUTF8(cx, "kill %d: %s", int(pid), strerror(err));
+    KandeloDecoratePendingError(cx, err);
+    return false;
+  }
+  args.rval().setInt32(0);
+  return true;
+}
