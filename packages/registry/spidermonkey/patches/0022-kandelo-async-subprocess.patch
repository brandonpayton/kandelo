+// Attach .errno (number) and .code (string) to the pending exception, matching
+// how Node surfaces a failed spawn/kill so callers can branch on err.code.
+static void KandeloDecoratePendingError(JSContext* cx, int err) {
+  RootedValue exc(cx);
+  if (!JS_GetPendingException(cx, &exc) || !exc.isObject()) {
+    return;
+  }
+  RootedObject excObj(cx, &exc.toObject());
+  RootedValue errnoVal(cx, Int32Value(err));
+  JS_SetProperty(cx, excObj, "errno", errnoVal);
+  const char* code = KandeloErrnoCode(err);
+  if (code) {
+    RootedString codeStr(cx, JS_NewStringCopyZ(cx, code));
+    if (codeStr) {
+      RootedValue codeVal(cx, StringValue(codeStr));
+      JS_SetProperty(cx, excObj, "code", codeVal);
+    }
+  }
+  JS_SetPendingException(cx, exc);
+}
