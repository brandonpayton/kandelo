+// __kandeloWaitPid(pid) -> Promise<{code, signal}>. Reaps via non-blocking
+// waitpid, registering a Child watch when the child is still running.
+static bool KandeloNativeWaitPid(JSContext* cx, unsigned argc, Value* vp) {
+  CallArgs args = CallArgsFromVp(argc, vp);
+  int32_t pid;
+  if (args.length() < 1 || !JS::ToInt32(cx, args[0], &pid)) {
+    return false;
+  }
+  RootedObject promise(cx, JS::NewPromiseObject(cx, nullptr));
+  if (!promise) {
+    return false;
+  }
+  args.rval().setObject(*promise);
+
+  int status = 0;
+  pid_t r = waitpid(pid_t(pid), &status, WNOHANG);
+  if (r == pid_t(pid)) {
+    return KandeloResolveChildFromStatus(cx, promise, status);
+  }
+  if (r == -1 && errno == ECHILD) {
+    return KandeloResolveChild(cx, promise, true, 0, nullptr);
+  }
+
+  auto* watch = js_new<KandeloSocketWatch>(cx, -1, KandeloSocketWatchKind::Child,
+                                           promise);
+  if (!watch) {
+    JS_ReportOutOfMemory(cx);
+    return false;
+  }
+  watch->childPid = pid_t(pid);
+  KandeloSocketWatchLink(watch);
+  return true;
+}
