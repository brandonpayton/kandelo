+// __kandeloSpawn(file, argv, env, actions, attrs) -> pid. Throws with
+// .errno/.code on posix_spawn failure (never a silent hang).
+static bool KandeloNativeSpawn(JSContext* cx, unsigned argc, Value* vp) {
+  CallArgs args = CallArgsFromVp(argc, vp);
+  if (args.length() < 2) {
+    JS_ReportErrorASCII(cx, "spawn requires a file and argv");
+    return false;
+  }
+  UniqueChars file;
+  if (!KandeloGetString(cx, args[0], &file)) {
+    return false;
+  }
+
+  std::vector<UniqueChars> argvStorage;
+  std::vector<char*> argvVec;
+  if (!KandeloStringArray(cx, args[1], &argvStorage, &argvVec)) {
+    return false;
+  }
+
+  std::vector<UniqueChars> envStorage;
+  std::vector<char*> envVec;
+  RootedValue envArg(cx, args.length() >= 3 ? args[2] : JS::UndefinedValue());
+  if (!KandeloStringArray(cx, envArg, &envStorage, &envVec)) {
+    return false;
+  }
+
+  posix_spawn_file_actions_t fa;
+  if (posix_spawn_file_actions_init(&fa) != 0) {
+    JS_ReportErrorASCII(cx, "spawn: cannot init file actions");
+    return false;
+  }
+  posix_spawnattr_t at;
+  if (posix_spawnattr_init(&at) != 0) {
+    posix_spawn_file_actions_destroy(&fa);
+    JS_ReportErrorASCII(cx, "spawn: cannot init attributes");
+    return false;
+  }
+
+  bool ok = true;
+  const char* actionErr = nullptr;
+
+  if (args.length() >= 4 && !args[3].isNullOrUndefined()) {
+    if (!args[3].isObject()) {
+      ok = false;
+      actionErr = "spawn actions must be an array";
+    } else {
+      RootedObject actions(cx, &args[3].toObject());
+      bool isArray = false;
+      uint32_t length = 0;
+      if (!JS::IsArrayObject(cx, actions, &isArray) || !isArray ||
+          !JS::GetArrayLength(cx, actions, &length)) {
+        ok = false;
+        actionErr = "spawn actions must be an array";
+      }
+      for (uint32_t i = 0; ok && i < length; i++) {
+        RootedValue elemVal(cx);
+        if (!JS_GetElement(cx, actions, i, &elemVal) || !elemVal.isObject()) {
+          ok = false;
+          actionErr = "spawn action must be an object";
+          break;
+        }
+        RootedObject elem(cx, &elemVal.toObject());
+        RootedValue opVal(cx);
+        UniqueChars op;
+        if (!JS_GetProperty(cx, elem, "op", &opVal) ||
+            !KandeloGetString(cx, opVal, &op)) {
+          ok = false;
+          actionErr = "spawn action needs an op";
+          break;
+        }
+        auto getInt = [&](const char* name, int32_t* out) -> bool {
+          RootedValue v(cx);
+          return JS_GetProperty(cx, elem, name, &v) && JS::ToInt32(cx, v, out);
+        };
+        int rc = 0;
+        if (strcmp(op.get(), "dup2") == 0) {
+          int32_t from = 0, to = 0;
+          if (!getInt("from", &from) || !getInt("to", &to)) {
+            ok = false;
+            actionErr = "dup2 needs from/to";
+            break;
+          }
+          rc = posix_spawn_file_actions_adddup2(&fa, from, to);
+        } else if (strcmp(op.get(), "close") == 0) {
+          int32_t fd = 0;
+          if (!getInt("fd", &fd)) {
+            ok = false;
+            actionErr = "close needs fd";
+            break;
+          }
+          rc = posix_spawn_file_actions_addclose(&fa, fd);
+        } else if (strcmp(op.get(), "open") == 0) {
+          int32_t fd = 0, flags = 0, mode = 0;
+          RootedValue pathVal(cx);
+          UniqueChars path;
+          if (!getInt("fd", &fd) || !getInt("flags", &flags) ||
+              !getInt("mode", &mode) ||
+              !JS_GetProperty(cx, elem, "path", &pathVal) ||
+              !KandeloGetString(cx, pathVal, &path)) {
+            ok = false;
+            actionErr = "open needs fd/path/flags/mode";
+            break;
+          }
+          rc = posix_spawn_file_actions_addopen(&fa, fd, path.get(), flags,
+                                                mode_t(mode));
+        } else if (strcmp(op.get(), "chdir") == 0) {
+          RootedValue pathVal(cx);
+          UniqueChars path;
+          if (!JS_GetProperty(cx, elem, "path", &pathVal) ||
+              !KandeloGetString(cx, pathVal, &path)) {
+            ok = false;
+            actionErr = "chdir needs path";
+            break;
+          }
+          rc = posix_spawn_file_actions_addchdir_np(&fa, path.get());
+        } else {
+          ok = false;
+          actionErr = "unknown spawn action op";
+          break;
+        }
+        if (rc != 0) {
+          posix_spawn_file_actions_destroy(&fa);
+          posix_spawnattr_destroy(&at);
+          JS_ReportErrorUTF8(cx, "spawn action %s: %s", op.get(), strerror(rc));
+          KandeloDecoratePendingError(cx, rc);
+          return false;
+        }
+      }
+    }
+  }
+
+  if (ok && args.length() >= 5 && args[4].isObject()) {
+    RootedObject attrs(cx, &args[4].toObject());
+    RootedValue flagsVal(cx);
+    int32_t flags = 0;
+    if (JS_GetProperty(cx, attrs, "flags", &flagsVal) &&
+        !flagsVal.isUndefined() && JS::ToInt32(cx, flagsVal, &flags) &&
+        flags != 0) {
+      posix_spawnattr_setflags(&at, short(flags));
+      if (flags & POSIX_SPAWN_SETPGROUP) {
+        RootedValue pgVal(cx);
+        int32_t pgroup = 0;
+        if (JS_GetProperty(cx, attrs, "pgroup", &pgVal) &&
+            JS::ToInt32(cx, pgVal, &pgroup)) {
+          posix_spawnattr_setpgroup(&at, pgroup);
+        }
+      }
+    }
+  }
+
+  if (!ok) {
+    posix_spawn_file_actions_destroy(&fa);
+    posix_spawnattr_destroy(&at);
+    JS_ReportErrorUTF8(cx, "%s", actionErr ? actionErr : "spawn: bad arguments");
+    return false;
+  }
+
+  pid_t pid = -1;
+  int rc = posix_spawn(&pid, file.get(), &fa, &at, argvVec.data(),
+                       envVec.data());
+  posix_spawn_file_actions_destroy(&fa);
+  posix_spawnattr_destroy(&at);
+  if (rc != 0) {
+    JS_ReportErrorUTF8(cx, "spawn %s: %s", file.get(), strerror(rc));
+    KandeloDecoratePendingError(cx, rc);
+    return false;
+  }
+  args.rval().setInt32(int32_t(pid));
+  return true;
+}
