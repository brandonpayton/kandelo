+// Marshal a JS array of strings into a NULL-terminated char* const[]. The
+// backing UniqueChars are kept alive in `storage`.
+static bool KandeloStringArray(JSContext* cx, HandleValue value,
+                               std::vector<UniqueChars>* storage,
+                               std::vector<char*>* out) {
+  storage->clear();
+  out->clear();
+  if (value.isNullOrUndefined()) {
+    out->push_back(nullptr);
+    return true;
+  }
+  if (!value.isObject()) {
+    JS_ReportErrorASCII(cx, "expected an array of strings");
+    return false;
+  }
+  RootedObject arr(cx, &value.toObject());
+  bool isArray = false;
+  if (!JS::IsArrayObject(cx, arr, &isArray) || !isArray) {
+    JS_ReportErrorASCII(cx, "expected an array of strings");
+    return false;
+  }
+  uint32_t length = 0;
+  if (!JS::GetArrayLength(cx, arr, &length)) {
+    return false;
+  }
+  for (uint32_t i = 0; i < length; i++) {
+    RootedValue element(cx);
+    if (!JS_GetElement(cx, arr, i, &element)) {
+      return false;
+    }
+    UniqueChars str;
+    if (!KandeloGetString(cx, element, &str)) {
+      return false;
+    }
+    out->push_back(str.get());
+    storage->push_back(std::move(str));
+  }
+  out->push_back(nullptr);
+  return true;
+}
