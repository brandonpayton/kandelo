+// Drive the JS-level real-delay timer wheel that adapter.js installs as
+// globalThis.__kandeloRunDueTimers / __kandeloNextTimerDelay. Without this the
+// wheel had no caller, so any setTimeout(fn, ms>0) never fired. Returns the
+// number of timers that fired this pass; *nextDelayMs is the ms until the next
+// pending timer (-1 when none pending).
+static int KandeloRunDueTimers(JSContext* cx, int64_t* nextDelayMs) {
+  *nextDelayMs = -1;
+  RootedObject global(cx, JS::CurrentGlobalOrNull(cx));
+  if (!global) {
+    return 0;
+  }
+  int fired = 0;
+
+  RootedValue runFn(cx);
+  if (JS_GetProperty(cx, global, "__kandeloRunDueTimers", &runFn) &&
+      runFn.isObject() && JS::IsCallable(&runFn.toObject())) {
+    RootedValue rval(cx);
+    if (JS_CallFunctionValue(cx, global, runFn, JS::HandleValueArray::empty(),
+                             &rval)) {
+      if (rval.isNumber()) {
+        fired = int(rval.toNumber());
+      }
+    } else {
+      JS_ClearPendingException(cx);
+    }
+  }
+
+  RootedValue delayFn(cx);
+  if (JS_GetProperty(cx, global, "__kandeloNextTimerDelay", &delayFn) &&
+      delayFn.isObject() && JS::IsCallable(&delayFn.toObject())) {
+    RootedValue rval(cx);
+    if (JS_CallFunctionValue(cx, global, delayFn, JS::HandleValueArray::empty(),
+                             &rval)) {
+      if (rval.isNumber()) {
+        double d = rval.toNumber();
+        if (d >= 0) {
+          *nextDelayMs = int64_t(d);
+        }
+      }
+    } else {
+      JS_ClearPendingException(cx);
+    }
+  }
+  return fired;
 }
 
